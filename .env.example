# ==============================================================================
# ANPR CLOUD SYSTEM - PRODUCTION & ENVIRONMENT CONFIGURATION
# ==============================================================================

# [1] SYSTEM & API SETTINGS
PROJECT_NAME="Vehicle Gate Monitoring Cloud"
API_V1_PREFIX="/api/v1"
DEBUG=false

# [2] DATABASE CONFIGURATION (PostgreSQL - Neon.tech, Supabase, or Railway)
# Paste your Neon PostgreSQL connection string directly.
# The system automatically translates 'sslmode=require' for asyncpg drivers.
DATABASE_URL="postgresql://neondb_owner:npg_XCw16WTvFgJo@ep-round-lake-b3r4psqn-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# [3] JWT AUTHENTICATION & SECURITY TOKENS
# Secret key used to sign JWT access tokens. Generate a random 32+ char string in production.
JWT_SECRET="forest-gate-jwt-super-secret-key-prod-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# [4] OBJECT STORAGE CONFIGURATION (Cloudflare R2 or Local)
# Set STORAGE_DRIVER="s3" for Cloudflare R2 / AWS S3 / MinIO. Set to "local" for local disk.
STORAGE_DRIVER="s3"
STORAGE_LOCAL_DIR="./media_storage"

# Cloudflare R2 S3-Compatible Credentials
# 1. Endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# 2. Access Key ID & Secret Key from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# 3. Bucket Name: Name of your R2 bucket (e.g. anpr-media)
# 4. Region: "auto" for Cloudflare R2
S3_ENDPOINT_URL="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_ACCESS_KEY="YOUR_CLOUDFLARE_R2_ACCESS_KEY_ID"
S3_SECRET_KEY="YOUR_CLOUDFLARE_R2_SECRET_ACCESS_KEY"
S3_BUCKET_NAME="anpr-media"
S3_REGION="auto"

# Optional: Public R2 CDN domain or custom domain (e.g. https://pub-xxxx.r2.dev or https://media.yourdomain.com)
# If provided, the system serves images via direct global CDN with $0 egress fees!
# If left empty, secure S3 presigned URLs are generated automatically.
S3_PUBLIC_URL=""
PRESIGNED_URL_EXPIRE_SECONDS=3600

# [5] SEEDED DEVICE KEY FOR CAMERAS & GATE BOX
# Pass this in the HTTP header 'X-API-Key' when sending events from camera webhooks or edge gateways
DEVICE_API_KEY="gate_key_HOSkVBNJj5hl4VJOXfrTUjY-6zQPKT7yLQq4lyjRf2k"

# [6] DETECTION & REVIEW THRESHOLDS
# Plates or cargo detections below these confidence levels are flagged as "needs_review"
CONF_THRESHOLD_LOAD=0.60
CONF_THRESHOLD_PLATE=0.85

# [7] BRUTE-FORCE SECURITY & LOCKOUT
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# [8] RETENTION & LOCALIZATION
# Automatically purges photo evidence older than X days to save storage
MEDIA_RETENTION_DAYS=90
DEFAULT_TIMEZONE="Asia/Kolkata"
CORS_ORIGINS='["*"]'
