# Forest Gate Vehicle Monitoring System Configuration
PROJECT_NAME="Vehicle Gate Monitoring Cloud"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Database Configuration (PostgreSQL 16 in prod/docker, sqlite+aiosqlite for local tests)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/anpr"

# JWT Authentication
JWT_SECRET="super-secret-key-forest-gate-change-in-prod-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage ("s3" or "local")
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./media_storage"
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="anpr-media"
S3_REGION="us-east-1"
PRESIGNED_URL_EXPIRE_SECONDS=600

# Edge Gate Box Tunnel
CLIP_BASE_URL=""

# Detection Thresholds
CONF_THRESHOLD_LOAD=0.60
CONF_THRESHOLD_PLATE=0.85

# Security
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Retention & Localization
MEDIA_RETENTION_DAYS=90
DEFAULT_TIMEZONE="Asia/Kolkata"
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
