# Caddy production reverse proxy configuration for Forest Gate Cloud Backend
{
    email mohitbaghel0202@gmail.com
    admin off
}

# Production domain with automated Let's Encrypt SSL & IP fallback
http://139.59.19.128, 139.59.19.128.sslip.io {
    encode gzip zstd

    # WebSocket Live Event Stream
    handle /ws/* {
        reverse_proxy api:8000
    }

    # API endpoints & OpenAPI documentation
    handle /api/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Docs and Health
    handle /docs* {
        reverse_proxy api:8000
    }
    handle /openapi.json* {
        reverse_proxy api:8000
    }
    handle /health* {
        reverse_proxy api:8000
    }

    # Serve React SPA static files & Dashboard from api:8000
    handle {
        reverse_proxy api:8000
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
